# veFaaS default ignore patterns
# Files and directories that will not be packaged and uploaded

# Version control
.git/
.svn/
.hg/

# Python virtual environments and dependencies (installed by function runtime)
.venv/
site-packages/
__pycache__/

# Node dependencies and local build/test output (the platform rebuilds from source)
node_modules/
.next/
out/
build/
coverage/
test-results/
playwright-report/
e2e/

# IDE and editors
.idea/
.vscode/
*.swp
*.swo

# System files
.DS_Store
Thumbs.db

# Local secrets and logs
.env
.env.*
*.log

# veFaaS CLI config
.vefaas/
