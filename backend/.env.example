# ===== 模型配置（默认 GLM-4-Flash，免费）=====
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_API_KEY=
LLM_MODEL=glm-4-flash
LLM_TEMPERATURE=0.8
LLM_MAX_TOKENS=300

# ===== 数据目录（结构化 JSON 文件持久化）=====
DATA_DIR=./data

# ===== 登录配置 =====
# 多个邀请码用英文逗号分隔；请勿提交真实生产邀请码
INVITE_CODES=your-private-invite-code
# 生产环境请替换为足够长的随机字符串
AUTH_SECRET=replace-with-a-long-random-string
