# ===== 应用环境 =====
APP_ENV=development
APP_TIMEZONE=Asia/Shanghai

# ===== 登录配置（以下均为示例值，不可直接用于生产）=====
# 旧版 INVITE_CODES 已停用；邀请码改用管理命令写入数据库。
AUTH_SECRET=dev-secret-change-me
INVITE_CODE_PEPPER=dev-invite-pepper-change-me
AUTH_TOKEN_TTL_SECONDS=2592000
ALLOW_LEGACY_TOKENS=false

# ===== 模型配置（Key 为空时使用本地回复，不调用真实模型）=====
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_API_KEY=
LLM_MODEL=glm-4-flash
LLM_TEMPERATURE=0.8
LLM_MAX_TOKENS=300

# ===== Agent 单次请求限制 =====
AGENT_MAX_MODEL_TURNS=4
AGENT_MAX_TOOL_CALLS=3
AGENT_MODEL_TIMEOUT_SECONDS=10
AGENT_TOTAL_TIMEOUT_SECONDS=25
AGENT_ACTION_TTL_SECONDS=300

# ===== 会话、记忆与脱敏轨迹 =====
CHAT_RECENT_MESSAGE_LIMIT=8
CHAT_PAGE_MESSAGE_LIMIT=50
CHAT_SESSION_LIST_LIMIT=20
CHAT_SUMMARY_TRIGGER_COUNT=20
CHAT_SUMMARY_TRIGGER_CHARS=4000
CHAT_SUMMARY_MAX_CHARS=1200
AGENT_CONTEXT_MAX_BYTES=16384
USER_MEMORY_MAX_CHARS=120
AGENT_TRACE_MAX_EVENTS=50
AGENT_EVENT_RETENTION_DAYS=30
CHAT_RETENTION_DAYS=30
# 仅用于日志匿名，生产环境必须单独设置，不得与 AUTH_SECRET 共用。
LOG_PSEUDONYM_SECRET=dev-log-pseudonym-change-me

# ===== 数据库 =====
DATA_DIR=./data
DATABASE_URL=sqlite+pysqlite:///./data/study_buddy.db
DATABASE_POOL_SIZE=5
DATABASE_POOL_TIMEOUT=10
STORAGE_BACKEND=database

# 正式环境必须使用 PostgreSQL，并通过部署平台注入真实连接地址：
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/study_buddy
